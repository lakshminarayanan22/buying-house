ENVIRONMENT=local
DATABASE_URL=postgresql+psycopg://bh:bh@localhost:5432/ecolink
APP_BASE_URL=http://localhost:3000

# --- Sign-in (docs/sign-in.md) ---------------------------------------------
# stub = type an address instead of using Google; local only, refused anywhere else.
GOOGLE_AUTH_BACKEND=stub
# GOOGLE_AUTH_BACKEND=google
# GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
ALLOWED_EMAIL_DOMAIN=ecolinksolutions.in
# Approved as Admin on their first Google sign-in. Comma-separated.
BOOTSTRAP_ADMIN_EMAILS=lakshmi@ecolinksolutions.in,maheswaran@ecolinksolutions.in,kartik@ecolinksolutions.in
# Required outside local. Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# JWT_SECRET=

# --- Email to admins / newly approved people ----------------------------------
# console = log instead of sending.
EMAIL_BACKEND=console
# EMAIL_BACKEND=smtp
# EMAIL_FROM=Ecolink <no-reply@ecolinksolutions.in>
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=no-reply@ecolinksolutions.in
# SMTP_PASSWORD=<16-character Google app password>

# --- Document search (embeddings) ----------------------------------------------
# stub = fake vectors, keyword search still works. voyage = real semantic search.
EMBEDDING_BACKEND=stub
# EMBEDDING_BACKEND=voyage
# VOYAGE_API_KEY=pa-...
# EMBEDDING_MODEL=voyage-4-large
# After switching, re-embed everything: .venv/bin/python -m scripts.reindex

# --- Chatbot model -------------------------------------------------------------
# stub   = placeholder answers, no model.
# ollama = free local model (Qwen). Install: brew install ollama && ollama pull qwen3:8b
# claude = the real thing; needs ANTHROPIC_API_KEY.
LLM_BACKEND=stub
# LLM_BACKEND=ollama
# OLLAMA_MODEL=qwen3:8b
# LLM_BACKEND=claude
# ANTHROPIC_API_KEY=sk-ant-...
# How much the model may wander. 0 is as repeatable as the model gets; above ~0.7 answers start
# rephrasing themselves between identical questions. Applies to every backend.
# LLM_TEMPERATURE=0.2   # classifying, phrasing answers, the technical and creative branches
# SQL_TEMPERATURE=0.1   # the step that writes SQL, wherever it runs
